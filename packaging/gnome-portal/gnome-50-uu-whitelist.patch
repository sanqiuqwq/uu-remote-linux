+/*
+ * Strict whitelist for uu-remote-linux. The app id comes from the frontend, which resolved it
+ * through org.freedesktop.host.portal.Registry for the caller's own D-Bus connection. The
+ * installed desktop file must exist as well, so an uninstalled or misspelled id falls back to
+ * the normal dialog. No other app id, and in particular no empty app id, is ever auto-approved.
+ */
+gboolean
+screen_cast_is_whitelisted_app (const char *app_id)
+{
+  const char * const *system_dirs;
+  g_autofree gchar *relative = NULL;
+  gboolean found = FALSE;
+
+  if (g_strcmp0 (app_id, "uu-remote-linux") != 0)
+    return FALSE;
+
+  relative = g_build_filename ("applications", "uu-remote-linux.desktop", NULL);
+  system_dirs = g_get_system_data_dirs ();
+  for (int i = 0; system_dirs[i] && !found; i++)
+    {
+      g_autofree gchar *path = g_build_filename (system_dirs[i], relative, NULL);
+      found = g_file_test (path, G_FILE_TEST_IS_REGULAR);
+    }
+  if (!found)
+    {
+      g_autofree gchar *path =
+        g_build_filename (g_get_user_data_dir (), relative, NULL);
+      found = g_file_test (path, G_FILE_TEST_IS_REGULAR);
+    }
+
+  if (!found)
+    g_warning ("Whitelisted app id %s has no installed desktop file, using the dialog",
+               app_id);
+
+  return found;
+}
+
+GPtrArray *
+screen_cast_auto_select_streams (ScreenCastSelection *selection)
+{
+  DisplayStateTracker *display_state_tracker = display_state_tracker_get ();
+  GList *logical_monitors =
+    display_state_tracker_get_logical_monitors (display_state_tracker);
+  GPtrArray *streams;
+  LogicalMonitor *primary = NULL;
+  GList *l;
+  uint32_t id = 0;
+
+  if (!selection->source_types.monitor)
+    return NULL;
+
+  streams = g_ptr_array_new_with_free_func (
+    (GDestroyNotify) screen_cast_stream_info_free);
+
+  for (l = logical_monitors; l; l = l->next)
+    {
+      if (logical_monitor_is_primary (l->data))
+        {
+          primary = l->data;
+          break;
+        }
+    }
+
+  if (!selection->multiple)
+    {
+      LogicalMonitor *chosen =
+        primary ? primary : (logical_monitors ? logical_monitors->data : NULL);
+      GList *monitors;
+
+      if (!chosen)
+        return streams;
+
+      for (monitors = logical_monitor_get_monitors (chosen);
+           monitors;
+           monitors = monitors->next)
+        {
+          ScreenCastStreamInfo *info = g_new0 (ScreenCastStreamInfo, 1);
+
+          info->type = SCREEN_CAST_SOURCE_TYPE_MONITOR;
+          info->data.monitor = monitor_dup (monitors->data);
+          info->id = id++;
+          g_ptr_array_add (streams, info);
+          break;
+        }
+
+      return streams;
+    }
+
+  for (l = logical_monitors; l; l = l->next)
+    {
+      GList *monitors;
+
+      for (monitors = logical_monitor_get_monitors (l->data);
+           monitors;
+           monitors = monitors->next)
+        {
+          ScreenCastStreamInfo *info = g_new0 (ScreenCastStreamInfo, 1);
+
+          info->type = SCREEN_CAST_SOURCE_TYPE_MONITOR;
+          info->data.monitor = monitor_dup (monitors->data);
+          info->id = id++;
+          g_ptr_array_add (streams, info);
+        }
+    }
+
+  return streams;
+}
